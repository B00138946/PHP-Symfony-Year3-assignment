{% extends 'base.html.twig' %}
    {% block title %}My Great Website - home page{% endblock %}
    {% block body %}
        <h1>Online Clothing Home page</h1>
        <p>
            welcome to my great website !
        </p>
        <style>
            a:link, a:visited {
                background-color: darkblue;
                color: white;
                border: 2px black;
                padding: 10px 20px;
                text-align: center;
                text-decoration: none;
                display: inline-block;
                border-radius: 12px;
            }

            a:hover, a:active {
                background-color: black;
                color: lightskyblue;
            }
        </style>





        <img src="{{ asset('Images/nikes.png') }}" alt="Image Description">
    {% endblock %}