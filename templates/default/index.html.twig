{% extends 'base.html.twig' %}
    {% block title %}My Great Website - home page{% endblock %}
    {% block body %}
        <h1>Online Store Home page</h1>
        <p>
            Welcome to the Online Store
        </p>
        <img src="{{ asset('images/brands.jpg') }}"class="brandspic">
<p></p>


        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
        <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.4/dist/jquery.slim.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
        <style>
            body {
                background-color: lightskyblue;
            }
            a:link, a:visited {
                background-color: darkblue;
                color: white;
                border: 2px black;
                padding: 10px 20px;
                text-align: center;
                text-decoration: none;
                display: inline-block;
                border-radius: 12px;
            }

            a:hover, a:active {
                background-color: black;
                color: lightskyblue;
            }

            shoppingC a:link, a:visited {
                background-color: darkblue;
                color: white;
                border: 2px black;
                padding: 10px 20px;
                text-align: center;
                text-decoration: none;
                display: inline-block;
                border-radius: 12px;
                float: right;
            }
            shoppingC a:hover, a:active {
                background-color: black;
                color: lightskyblue;
            }
            .brandspic {
                width: 600px;
                height: auto;
                border: 2px solid darkblue;
            }


        </style>

        <a href="{{ path('shoppingCart')  }}" class="shoppingC">
            Shopping cart</a>

        <a href="{{ url('app_user_index') }}">
            Account
        </a>





            {% for productDetails in productDetailss %}
            <div class="container">

                <h2>{{ productDetails.ClothingName }}</h2>
                <div class="card bg-primary text-white" style="width: 18rem;height: 100%">
                    <div class="card-body" style>{{ productDetails.Brand }}</div>
                    <div class="card-body">{{ productDetails.Price }}</div>
                </div>

                {% else %}
                    <tr>
                        <td colspan="4">no records found</td>
                    </tr>
                {% endfor %}
            </div>


    {% endblock %}