{% extends 'base.html.twig' %}

{% block title %}Phone index{% endblock %}

{% block body %}
    <h1>Phone index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Brand</th>
                <th>Price</th>
                <th>Size</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for phone in phones %}
            <tr>
                <td>{{ phone.id }}</td>
                <td>{{ phone.Brand }}</td>
                <td>{{ phone.Price }}</td>
                <td>
                    <a href="{{ path('app_make_show', {'id': phone.Size.id}) }}">{{ phone.Size.name }}</a>


                </td>
                <td>
                    <a href="{{ path('app_phone_show', {'id': phone.id}) }}">show</a>
                    <a href="{{ path('app_phone_edit', {'id': phone.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_phone_new') }}">Create new</a>
{% endblock %}
